    "deviceIdentifiers": "Installation identifier and server-side hash; not Advertising ID.",
    "diagnostics": "Operational error codes and voice timing; no raw transcript or credentials logged by the audited timing endpoint.",
    "location": "No device-location collection or location derivation from IP was identified in Brain features. Network IP used for rate limiting is not declared as location.",
    "files": "Training/memory import supports PDF, TXT, MD, DOCX, CSV and JSON after explicit user action and AI consent.",
    "photosCamera": "Shared iOS purpose strings do not establish active Brain camera/photo access; none identified in current Brain implementation.",
    "transcripts": "Explicitly saved transcripts are account-scoped local secure storage. AI processing and selected cloud Brain memories remain disclosed separately."

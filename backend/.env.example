OPENAI_API_KEY=put_your_key_here
OPENAI_MODEL=gpt-6-astra
PORT=8787

# Auto-Email mailbox connections. Off until dedicated provider apps are ready.
# Keep the 32-byte key (64 hex characters) and client secrets server-side only.
KORLIX_AUTO_EMAIL_MAILBOX_OAUTH_ENABLED=false
KORLIX_AUTO_EMAIL_TOKEN_KEY=
KORLIX_AUTO_EMAIL_GOOGLE_CLIENT_ID=
KORLIX_AUTO_EMAIL_GOOGLE_CLIENT_SECRET=
KORLIX_AUTO_EMAIL_MICROSOFT_CLIENT_ID=
KORLIX_AUTO_EMAIL_MICROSOFT_CLIENT_SECRET=
KORLIX_AUTO_EMAIL_MICROSOFT_TENANT=organizations
KORLIX_AUTO_EMAIL_APP_ORIGIN=https://korlix-auto-email-by-voice.silkyhinny128.chatgpt.site
KORLIX_AUTO_EMAIL_API_ORIGIN=https://chee-chai-chee-backend.onrender.com

# Explicit on-screen sending pilot. Keep false except during an authorized private provider trial.
KORLIX_AUTO_EMAIL_SENDING_ENABLED=false
KORLIX_AUTO_EMAIL_DAILY_SEND_CAP=5

# Magic Camera: optional store sales remain off until the dedicated app SKUs are ready.
# Rendering uses the existing server-only OpenAI key and fixed Sunburst max quality.
KORLIX_MAGIC_CAMERA_BILLING_ENABLED=false
KORLIX_MAGIC_APPLE_BILLING_ENABLED=false
KORLIX_MAGIC_APPLE_APP_ID=
# Reuses KORLIX_APPLE_ISSUER_ID / KORLIX_APPLE_KEY_ID / KORLIX_APPLE_PRIVATE_KEY_BASE64.
# Apple server notification URL: /api/magic-camera/billing/apple/notifications
# Google uses the existing authenticated billing notification intake and Magic package routing.
